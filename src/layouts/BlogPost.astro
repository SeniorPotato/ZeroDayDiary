---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getPrimaryCategory, getTagTheme } from '../data/categories';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
const primaryCat = getPrimaryCategory(tags);
const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const pageText = `${title} ${description}`;
const readingTime = estimateReadingTime(pageText);
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | ${primaryCat.title} Briefing | ZeroDayDiary`} description={description} image={heroImage} />
		<style>
			main { width: min(1180px, calc(100% - 2rem)); max-width: none; padding-top: 1.15rem; }
			.article-shell { display: grid; gap: 1rem; }
			.title-wrap {
				width: min(980px, 100%);
				margin: 0 auto;
				padding: 0.5rem 0 0.35rem;
			}
			.title-panel {
				padding: 1.25rem 1.3rem;
				border-radius: 1rem;
				background:
					radial-gradient(circle at top left, rgba(34, 211, 238, 0.08), transparent 26%),
					radial-gradient(circle at 85% 12%, rgba(139, 92, 246, 0.1), transparent 24%),
					linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.7));
				border: 1px solid rgba(148, 163, 184, 0.12);
				box-shadow: 0 18px 44px rgba(2, 6, 23, 0.24);
			}
			.title-main {
				min-width: 0;
				max-width: 100%;
			}
			.top-meta {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.75rem;
				margin: 0 0 1rem;
			}
			.topic-chip {
				display:inline-block;
				font-size:.72rem;
				font-weight:700;
				text-transform:uppercase;
				letter-spacing:.1em;
				padding:.25rem .58rem;
				border-radius:999px;
				border:1px solid;
			}
			.meta-inline {
				display:flex;
				flex-wrap:wrap;
				gap:0.55rem;
				align-items:center;
				font-size:0.8rem;
				text-transform:uppercase;
				letter-spacing:0.1em;
				color: rgba(226, 232, 240, 0.78);
			}
			.meta-inline strong { color:#f8fafc; font-size:0.92rem; letter-spacing:0; text-transform:none; }
			.meta-sep { color: rgba(148, 163, 184, 0.7); }
			.title h1 { margin: 0.15rem 0 0.9rem; font-size: clamp(2.45rem, 5vw, 4.8rem); line-height: 0.94; max-width: 18ch; }
			.deck { font-size: 1.12rem; color: rgba(226, 232, 240, 0.8); max-width: 68ch; margin: 0 0 1rem; }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.42rem; list-style: none; padding: 0; margin: 0; }
			.tag-list li { font-size: 0.73rem; padding: 0.28rem 0.5rem; border-radius: 999px; border:1px solid; }
			.hero-image {
				width: min(980px, 100%);
				margin: 0 auto;
			}
			.hero-image img { display: block; width: 100%; margin: 0 auto; border-radius: 16px; box-shadow: 0 20px 56px rgba(2, 6, 23, 0.28); }
			.prose {
				width: min(820px, 100%);
				margin: 0 auto;
				padding: 0 0 2rem;
				color: rgb(var(--gray-dark));
			}
			.prose-inner {
				padding: 1.15rem 1.2rem 1.5rem;
				border-radius: 1rem;
				background: linear-gradient(180deg, rgba(15, 23, 42, 0.62), rgba(15, 23, 42, 0.38));
				border: 1px solid rgba(148, 163, 184, 0.1);
			}
			:global(.prose h2) {
				margin-top: 2.2rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(148, 163, 184, 0.16);
				font-size: 1.18rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #e2e8f0;
			}
			:global(.prose h2:first-child) { margin-top: 0; }
			:global(.prose p), :global(.prose li) {
				font-size: 1.04rem;
				line-height: 1.78;
				color: rgba(226, 232, 240, 0.84);
			}
			:global(.prose p + p) { margin-top: -0.15rem; }
			:global(.prose ul) { padding-left: 1.15rem; }
			:global(.prose li + li) { margin-top: 0.45rem; }
			:global(.prose a) { color: #7dd3fc; text-decoration: none; }
			:global(.prose a:hover) { text-decoration: underline; }
			:global(.prose strong) { color: #f8fafc; }
			:global(.prose blockquote) {
				margin: 1.5rem 0;
				padding: 0.95rem 1rem;
				border-left: 3px solid #22d3ee;
				background: rgba(15, 23, 42, 0.5);
				border-radius: 0.6rem;
			}
			:global(.prose hr) { margin: 2rem 0; }
			@media (max-width: 760px) {
				.title-panel, .prose-inner { padding: 1rem; }
				.title h1 { font-size: clamp(2rem, 10vw, 3.2rem); }
				.deck { font-size: 1rem; }
				:global(.prose p), :global(.prose li) { font-size: 1rem; line-height: 1.72; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="article-shell">
				<div class="title-wrap title">
					<div class="title-panel">
						<div class="title-main">
							<div class="top-meta">
								<span class="topic-chip" style={`color:${primaryCat.color};background:${primaryCat.chipBackground};border-color:${primaryCat.color}33`}>{primaryCat.title}</span>
								<div class="meta-inline">
									<span><FormattedDate date={pubDate} /></span>
									<span class="meta-sep">•</span>
									<span><strong>{readingTime} min read</strong></span>
									{updatedDate && <><span class="meta-sep">•</span><span>Updated <FormattedDate date={updatedDate} /></span></>}
								</div>
								{tags.length > 0 && <ul class="tag-list">{tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>}
							</div>
							<h1>{title}</h1>
							<p class="deck">{description}</p>
						</div>
					</div>
				</div>
				<div class="hero-image">{heroImage && <Image width={1260} height={720} src={heroImage} alt="" />}</div>
				<div class="prose">
					<div class="prose-inner">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
