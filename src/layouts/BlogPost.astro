---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main { width: min(1080px, calc(100% - 2rem)); max-width: none; padding-top: 2rem; }
			.article-shell { display: grid; gap: 1.5rem; }
			.hero-image img { display: block; width: 100%; margin: 0 auto; border-radius: 18px; box-shadow: var(--box-shadow); }
			.prose {
				width: min(760px, 100%);
				margin: 0 auto;
				padding: 1em 0 2em;
				color: rgb(var(--gray-dark));
			}
			.title { margin-bottom: 1.6rem; }
			.title h1 { margin: 0.35rem 0 0.8rem; font-size: clamp(2.4rem, 6vw, 4.5rem); }
			.date { margin-bottom: 0.8rem; color: rgb(var(--gray)); display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; }
			.last-updated-on { font-style: italic; }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; padding: 0; margin: 0 0 1rem; }
			.tag-list li { font-size: 0.78rem; padding: 0.35rem 0.55rem; border-radius: 999px; background: rgba(34,211,238,0.12); color: #a5f3fc; }
			.deck { font-size: 1.18rem; color: rgba(226, 232, 240, 0.78); max-width: 52ch; }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="article-shell">
				<div class="prose title">
					<ul class="tag-list">{tags.map((tag) => <li>{tag}</li>)}</ul>
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && <div class="last-updated-on">Updated <FormattedDate date={updatedDate} /></div>}
					</div>
					<h1>{title}</h1>
					<p class="deck">{description}</p>
				</div>
				<div class="hero-image">{heroImage && <Image width={1260} height={720} src={heroImage} alt="" />}</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
