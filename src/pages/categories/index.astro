---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { CATEGORY_LIST } from '../../data/categories';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = Object.fromEntries(
  CATEGORY_LIST.map((category) => [
    category.slug,
    posts.filter((post) => post.data.tags.includes(category.slug)).length,
  ]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Categories | ${SITE_TITLE}`} description="Browse ZeroDayDiary by category." />
    <style>
      main { width: min(1180px, calc(100% - 2rem)); max-width: none; }
      .page-head { margin: .8rem 0 1.7rem; }
      .eyebrow { margin:0 0 .7rem; font-size:.76rem; text-transform:uppercase; letter-spacing:.18em; color:#22d3ee; }
      .page-head p { max-width: 46rem; color: rgba(226,232,240,0.74); }
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .85rem; }
      .card {
        padding: 1.1rem 1.15rem;
        border-radius: 1.05rem;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.68));
        border: 1px solid rgba(148, 163, 184, 0.12);
        box-shadow: 0 18px 44px rgba(2, 6, 23, 0.25);
      }
      .card a { text-decoration: none; color: #f8fafc; }
      .card h2 { margin: .2rem 0 .5rem; }
      .card p { color: rgba(226,232,240,0.74); }
      .count { font-size: .76rem; text-transform: uppercase; letter-spacing: .14em; color: #7dd3fc; }
      .text-link { text-decoration:none; color:#a5f3fc; font-weight:700; }
      @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="page-head">
        <p class="eyebrow">Browse the archive</p>
        <h1>Categories</h1>
        <p>Navigate ZeroDayDiary by reporting lane. Each category page groups briefings by recurring risk pattern rather than by platform hype cycle.</p>
        <p><a class="text-link" href="/blog">Prefer the full feed? Open all briefings →</a></p>
      </section>
      <section class="grid">
        {CATEGORY_LIST.map((category) => (
          <article class="card">
            <p class="count">{counts[category.slug]} entries</p>
            <h2><a href={`/categories/${category.slug}/`}>{category.title}</a></h2>
            <p>{category.description}</p>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>
