---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { CATEGORY_META, CATEGORY_LIST } from '../../data/categories';

export async function getStaticPaths() {
  return CATEGORY_LIST.map(({ slug }) => ({ params: { category: slug } }));
}

const category = Astro.params.category ?? 'security';
const meta = CATEGORY_META[category as keyof typeof CATEGORY_META];
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(category))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${meta.title} | ${SITE_TITLE}`} description={meta.description} />
    <style>
      main { width: min(1180px, calc(100% - 2rem)); max-width: none; }
      .page-head { margin: 1rem 0 2rem; }
      .page-head p { max-width: 50rem; color: rgba(226,232,240,0.74); }
      .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .card {
        padding: 1.35rem;
        border-radius: 1.35rem;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.62));
        border: 1px solid rgba(148, 163, 184, 0.12);
        box-shadow: 0 22px 60px rgba(2, 6, 23, 0.28);
      }
      .card h2 { margin: 0.35rem 0 0.6rem; font-size: 1.6rem; }
      .card h2 a { text-decoration: none; color: #f8fafc; }
      .meta { font-size: 0.85rem; color: #7dd3fc; }
      .tag-list { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; padding: 0; margin: 1rem 0 0; }
      .tag-list li { font-size: 0.78rem; padding: 0.35rem 0.55rem; border-radius: 999px; background: rgba(34,211,238,0.12); color: #a5f3fc; }
      @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="page-head">
        <p class="eyebrow">Category / {meta.title}</p>
        <h1>{meta.title}</h1>
        <p>{meta.description}</p>
      </section>
      <section class="grid">
        {posts.map((post) => (
          <article class="card">
            <p class="meta"><FormattedDate date={post.data.pubDate} /></p>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>
