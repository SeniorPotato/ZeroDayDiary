---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORY_LIST, getPrimaryCategory } from '../data/categories';

const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: estimateReadingTime(`${post.data.title} ${post.data.description} ${post.body}`),
	}));

const [lead, ...remaining] = allPosts;
const todaysBriefings = remaining.slice(0, 3);
const latestUpdates = remaining.slice(3, 9);
const categoryCounts = Object.fromEntries(
	CATEGORY_LIST.map((category) => [
		category.slug,
		allPosts.filter((post) => post.data.tags.includes(category.slug)).length,
	]),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Global security / privacy / AI risk</p>
					<h1>Signal-first reporting on what changed, what broke, and what matters next.</h1>
					<p class="lede">
						ZeroDayDiary is a compact global journal tracking breaches, surveillance shifts,
						AI governance failures, and privacy-relevant policy changes.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">Latest briefings</a>
						<a class="button secondary" href="/search">Search archive</a>
						<a class="button secondary" href="/categories">Browse categories</a>
					</div>
				</div>
			</section>

			{lead && (
				<section class="lead-block">
					<div class="section-head split compact">
						<div>
							<p class="eyebrow">Lead briefing</p>
							<h2>Start here</h2>
						</div>
						<a class="text-link" href="/blog">Open archive →</a>
					</div>
					<article class="lead-story">
						<div class="lead-story-copy">
							{(() => { const cat = getPrimaryCategory(lead.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
							<div class="meta-row">
								<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{lead.readingTime} min read</p>
							</div>
							<h3><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3>
							<p class="desc">{lead.data.description}</p>
							{lead.data.tags.length > 0 && <ul class="tag-list">{lead.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
						</div>
					</article>
				</section>
			)}

			<section class="briefing-grid">
				<div class="section-head compact">
					<p class="eyebrow">Today’s briefings</p>
					<h2>Newest entries</h2>
				</div>
				<div class="post-grid dense three-up">
					{todaysBriefings.map((post) => (
						<article class="post-card compact-card">
							<div>
								{(() => { const cat = getPrimaryCategory(post.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
							{post.data.tags.length > 0 && <ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
						</article>
					))}
				</div>
			</section>

			<section class="latest-updates">
				<div class="section-head compact">
					<p class="eyebrow">Latest updates</p>
					<h2>More from the archive</h2>
				</div>
				<div class="post-grid dense two-up">
					{latestUpdates.map((post) => (
						<article class="post-card compact-card">
							<div>
								{(() => { const cat = getPrimaryCategory(post.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
							{post.data.tags.length > 0 && <ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
						</article>
					))}
				</div>
			</section>

			<section class="categories-section">
				<div class="section-head split compact">
					<div>
						<p class="eyebrow">Categories</p>
						<h2>Track by lane</h2>
					</div>
					<a class="text-link" href="/categories">View all topics →</a>
				</div>
				<div class="category-grid">
					{CATEGORY_LIST.map((category) => (
						<article class="category-card">
							<p class="category-count">{categoryCounts[category.slug]} entries</p>
							<h3><a href={`/categories/${category.slug}/`}>{category.title}</a></h3>
							<p>{category.description}</p>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell { width: min(1180px, calc(100% - 2rem)); max-width: none; padding: 1.4rem 0 4rem; }
	.hero { display:grid; grid-template-columns: 1fr; gap: 1rem; align-items: start; padding: 1.6rem 0 1rem; }
	.eyebrow { margin:0 0 .8rem; font-size:.76rem; text-transform:uppercase; letter-spacing:.18em; color:#22d3ee; }
	.hero h1 { font-size: clamp(2.35rem, 4.4vw, 4.2rem); line-height: .95; max-width: 13ch; margin-bottom: 1rem; }
	.lede { font-size: 1.04rem; max-width: 46rem; color: rgba(226,232,240,.76); }
	.hero-actions { display:flex; gap:.75rem; margin-top:1.35rem; flex-wrap:wrap; }
	.button { display:inline-flex; align-items:center; justify-content:center; padding:.85rem 1.15rem; border-radius:999px; text-decoration:none; font-weight:700; }
	.button.primary { background: linear-gradient(135deg, #06b6d4, #8b5cf6); color:#fff; box-shadow:0 16px 40px rgba(34,211,238,.16); }
	.button.secondary { border:1px solid rgba(148,163,184,.24); color:#e2e8f0; }
	.lead-story, .compact-card, .category-card { padding:1.1rem 1.15rem; border-radius:1.05rem; background:linear-gradient(180deg, rgba(15,23,42,.9), rgba(15,23,42,.7)); border:1px solid rgba(148,163,184,.12); box-shadow:0 18px 44px rgba(2,6,23,.25); }
	.section-head.compact { margin-bottom: .95rem; }
	.section-head.split { display:flex; justify-content:space-between; align-items:end; gap:1rem; }
	.text-link { text-decoration:none; font-weight:700; color:#a5f3fc; }
	.lead-block, .briefing-grid, .latest-updates, .categories-section { margin: 0 0 2rem; }
	.lead-story-copy { max-width: 52rem; }
	.lead-story h3 { margin:.2rem 0 .5rem; font-size: 1.45rem; line-height:1.08; max-width: 28ch; }
	.compact-card h3, .category-card h3 { margin:.2rem 0 .5rem; }
	.compact-card h3 { font-size:1.16rem; line-height:1.12; max-width: 26ch; }
	.lead-story h3 a, .compact-card h3 a, .category-card h3 a { text-decoration:none; color:#f8fafc; }
	.post-grid.dense, .category-grid { display:grid; gap:.85rem; }
	.post-grid.three-up { grid-template-columns: repeat(3, 1fr); }
	.post-grid.two-up { grid-template-columns: repeat(2, 1fr); }
	.category-grid { grid-template-columns: repeat(3, 1fr); }
	.compact-card, .category-card { min-height: 250px; }
	.compact-card { display:flex; flex-direction:column; justify-content:space-between; }
	.compact-card p, .category-card p { color: rgba(226,232,240,.72); }
	.meta { font-size:.78rem; color:#bae6fd; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }
	.meta-row { display:flex; gap:.55rem; align-items:center; flex-wrap:wrap; margin-bottom:.35rem; }
	.meta-dot { color: rgba(148,163,184,.7); }
	.desc { color: rgba(226,232,240,.8); line-height:1.58; font-size:.95rem; max-width:52ch; }
	.tag-list { display:flex; flex-wrap:wrap; gap:.45rem; list-style:none; padding:0; margin:1rem 0 0; }
	.tag-list li { font-size:.73rem; font-weight:700; padding:.32rem .55rem; border-radius:999px; background:rgba(34,211,238,.2); color:#ecfeff; border:1px solid rgba(103,232,249,.22); }
	.topic-chip { display:inline-block; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.22rem .52rem; border-radius:999px; border:1px solid; margin-bottom:.45rem; }
	.category-count { font-size:.74rem; letter-spacing:.12em; text-transform:uppercase; color:#7dd3fc; }
	@media (max-width: 960px) {
		.post-grid.three-up, .post-grid.two-up, .category-grid { grid-template-columns: 1fr 1fr; }
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: clamp(1.95rem, 10vw, 2.8rem); }
		.post-grid.three-up, .post-grid.two-up, .category-grid { grid-template-columns: 1fr; }
		.section-head.split { flex-direction:column; align-items:flex-start; }
	}
</style>
