---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const [lead, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent risk journal</p>
					<h1>Global reporting on security failures, privacy erosion, and AI risk.</h1>
					<p class="lede">
						ZeroDayDiary tracks the developments that matter after the headlines move on:
						breaches, surveillance shifts, governance failures, safety regressions, and model misuse.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">Open latest briefings</a>
						<a class="button secondary" href="/about">Read the editorial mission</a>
					</div>
					<div class="hero-metrics">
						<div><strong>Git-first</strong><span>Every change is reviewable</span></div>
						<div><strong>Static by design</strong><span>Fast, low-maintenance, low surface area</span></div>
						<div><strong>Operator-focused</strong><span>Signal over commentary</span></div>
					</div>
				</div>
				<div class="hero-panel">
					<div class="panel-card lead-brief">
						<p class="panel-label">Current posture</p>
						<h2>Three lanes, one editorial filter.</h2>
						<ul>
							<li><strong>Security:</strong> breaches, exploit chains, systemic weaknesses</li>
							<li><strong>Privacy:</strong> surveillance, data misuse, regulatory drift</li>
							<li><strong>AI risk:</strong> misuse, governance failures, safety regressions</li>
						</ul>
					</div>
					<div class="panel-card muted note-card">
						<p class="panel-label">Publishing chain</p>
						<p>Draft in Markdown → review in pull request → CI checks → deploy to edge.</p>
					</div>
				</div>
			</section>

			<section class="editorial-band">
				<div class="band-copy">
					<p class="eyebrow">Method</p>
					<h2>Built like a system, not a brochure.</h2>
				</div>
				<div class="band-grid">
					<article>
						<span>01</span>
						<h3>Collect</h3>
						<p>Monitor high-signal developments across security, privacy, and AI governance.</p>
					</article>
					<article>
						<span>02</span>
						<h3>Reduce</h3>
						<p>Strip out noise, hype, and duplicated reporting to get to the operational substance.</p>
					</article>
					<article>
						<span>03</span>
						<h3>Publish</h3>
						<p>Ship briefings through a reviewable workflow with reproducible deployment.</p>
					</article>
				</div>
			</section>

			{lead && (
				<section class="featured-section">
					<div class="section-head split">
						<div>
							<p class="eyebrow">Featured briefing</p>
							<h2>Start with the current lead entry</h2>
						</div>
						<a class="text-link" href="/blog">View full archive →</a>
					</div>
					<article class="feature-card">
						<div class="feature-copy">
							<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
							<h3><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3>
							<p>{lead.data.description}</p>
							{lead.data.tags.length > 0 && (
								<ul class="tag-list">
									{lead.data.tags.map((tag) => <li>{tag}</li>)}
								</ul>
							)}
						</div>
					</article>
				</section>
			)}

			<section class="latest">
				<div class="section-head">
					<p class="eyebrow">Recent entries</p>
					<h2>New briefings</h2>
				</div>
				<div class="post-grid">
					{rest.map((post) => (
						<article class="post-card">
							<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
							{post.data.tags.length > 0 && (
								<ul class="tag-list">
									{post.data.tags.map((tag) => <li>{tag}</li>)}
								</ul>
							)}
						</article>
					))}
				</div>
			</section>

			<section class="subscribe-strip">
				<div>
					<p class="eyebrow">Next iteration</p>
					<h2>Newsletter block ready for integration.</h2>
					<p>
						This space is reserved for Buttondown / Beehiiv / ConvertKit once you choose the provider.
					</p>
				</div>
				<a class="button secondary" href="/about">Set editorial policy first</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell {
		width: min(1180px, calc(100% - 2rem));
		max-width: none;
		padding: 2rem 0 4rem;
	}
	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 1.5rem;
		align-items: stretch;
		padding: 3rem 0 2rem;
	}
	.hero-copy,
	.hero-panel,
	.editorial-band,
	.feature-card,
	.post-card,
	.subscribe-strip {
		position: relative;
	}
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #22d3ee;
	}
	.hero h1 {
		font-size: clamp(3.2rem, 7vw, 6.1rem);
		line-height: 0.92;
		max-width: 11ch;
		margin-bottom: 1.3rem;
	}
	.lede {
		font-size: 1.18rem;
		max-width: 44rem;
		color: rgba(226, 232, 240, 0.78);
	}
	.hero-actions {
		display: flex;
		gap: 0.9rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}
	.hero-metrics {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.85rem;
		margin-top: 2rem;
	}
	.hero-metrics div,
	.band-grid article,
	.feature-card,
	.post-card,
	.subscribe-strip,
	.panel-card {
		padding: 1.25rem;
		border-radius: 1.35rem;
		background: linear-gradient(180deg, rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.62));
		border: 1px solid rgba(148, 163, 184, 0.12);
		box-shadow: 0 22px 60px rgba(2, 6, 23, 0.28);
	}
	.hero-metrics strong,
	.band-grid h3 {
		display: block;
		margin-bottom: 0.35rem;
		color: #f8fafc;
	}
	.hero-metrics span,
	.band-grid p,
	.subscribe-strip p,
	.feature-card p,
	.post-card p,
	.panel-card p,
	.panel-card li {
		color: rgba(226, 232, 240, 0.74);
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.95rem 1.3rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
	}
	.button.primary {
		background: linear-gradient(135deg, #06b6d4, #8b5cf6);
		color: #fff;
		box-shadow: 0 16px 50px rgba(34, 211, 238, 0.18);
	}
	.button.secondary {
		border: 1px solid rgba(148, 163, 184, 0.24);
		color: #e2e8f0;
	}
	.hero-panel {
		display: grid;
		gap: 1rem;
	}
	.lead-brief h2 {
		font-size: 2rem;
		margin-bottom: 0.8rem;
	}
	.panel-card ul {
		margin: 0;
		padding-left: 1.2rem;
	}
	.panel-label {
		margin: 0 0 0.8rem;
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #93c5fd;
	}
	.note-card {
		background: linear-gradient(180deg, rgba(76, 29, 149, 0.22), rgba(15, 23, 42, 0.74));
	}
	.editorial-band {
		margin: 1rem 0 4rem;
		padding: 1.5rem;
		border-radius: 1.6rem;
		background: linear-gradient(90deg, rgba(8, 15, 31, 0.65), rgba(15, 23, 42, 0.12));
		border: 1px solid rgba(148, 163, 184, 0.1);
	}
	.band-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.band-grid span {
		display: inline-flex;
		width: 2rem;
		height: 2rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: rgba(34, 211, 238, 0.14);
		color: #67e8f9;
		font-size: 0.85rem;
		font-weight: 700;
		margin-bottom: 0.85rem;
	}
	.section-head {
		margin-bottom: 1.3rem;
	}
	.section-head.split {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
	}
	.text-link {
		text-decoration: none;
		font-weight: 700;
		color: #a5f3fc;
	}
	.featured-section {
		margin-bottom: 3rem;
	}
	.feature-card h3,
	.post-card h3 {
		margin: 0.35rem 0 0.6rem;
	}
	.feature-card h3 a,
	.post-card h3 a {
		text-decoration: none;
		color: #f8fafc;
	}
	.feature-card {
		padding: 1.55rem;
	}
	.feature-copy {
		max-width: 50rem;
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}
	.meta {
		font-size: 0.85rem;
		color: #7dd3fc;
		margin-bottom: 0.3rem;
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}
	.tag-list li {
		font-size: 0.78rem;
		padding: 0.35rem 0.55rem;
		border-radius: 999px;
		background: rgba(34, 211, 238, 0.12);
		color: #a5f3fc;
	}
	.subscribe-strip {
		margin-top: 3rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		background: linear-gradient(135deg, rgba(6, 182, 212, 0.08), rgba(139, 92, 246, 0.12));
	}
	@media (max-width: 960px) {
		.hero,
		.band-grid,
		.post-grid,
		.hero-metrics {
			grid-template-columns: 1fr;
		}
		.section-head.split,
		.subscribe-strip {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
