---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORY_LIST } from '../data/categories';

const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const cleanSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: estimateReadingTime(`${post.data.title} ${post.data.description} ${post.body}`),
	}));

const [lead, ...remaining] = allPosts;
const todaysBriefings = remaining.slice(0, 3);
const categoryCounts = Object.fromEntries(
	CATEGORY_LIST.map((category) => [
		category.slug,
		allPosts.filter((post) => post.data.tags.includes(category.slug)).length,
	]),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cybersecurity, Privacy & AI Risk Briefings | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent cybersecurity / privacy / AI risk journal</p>
					<h1>Signal over noise</h1>
					<p class="lede">
						A restrained field journal for cybersecurity, privacy, and AI risk signals worth keeping.
					</p>
					<div class="hero-actions" aria-label="Primary actions">
						<a class="button primary" href="/blog">Read latest</a>
						<a class="button secondary" href="/search">Search archive</a>
					</div>
				</div>
			</section>

			{lead && (
				<section class="lead-block">
					<div class="section-head split compact">
						<div>
							<p class="eyebrow">Lead briefing</p>
							<h2>Featured briefing</h2>
						</div>
						<a class="text-link" href="/blog">Open full archive →</a>
					</div>
					<article class="lead-story">
						<div class="lead-kicker">
							<div class="meta-row">
								<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{lead.readingTime} min read</p>
							</div>
						</div>
						<div class="lead-story-copy">
							<h3><a href={`/blog/${cleanSlug(lead.id)}/`}>{lead.data.title}</a></h3>
							<p class="desc lead-desc">{lead.data.description}</p>
						</div>
					</article>
				</section>
			)}

			<section class="briefing-grid">
				<div class="section-head compact">
					<p class="eyebrow">Latest</p>
					<h2>Recent entries</h2>
				</div>
				<div class="post-grid dense three-up">
					{todaysBriefings.map((post) => (
						<article class="post-card compact-card">
							<div>
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${cleanSlug(post.id)}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>


			<section class="categories-section">
				<div class="section-head split compact">
					<div>
						<p class="eyebrow">Topics</p>
						<h2>Topics</h2>
					</div>
					<a class="text-link" href="/categories">View all topics →</a>
				</div>
				<div class="category-grid">
					{CATEGORY_LIST.map((category) => (
						<article class="category-card">
							<p class="category-count">{categoryCounts[category.slug]} entries</p>
							<h3><a href={`/categories/${category.slug}/`}>{category.title}</a></h3>
							<p>{category.description}</p>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell {
		width: min(1040px, calc(100% - 2rem));
		max-width: none;
		padding: 3rem 0 4.5rem;
	}
	.hero {
		padding: 4rem 0 3.5rem;
		border-bottom: 1px solid rgba(148, 163, 184, 0.14);
	}
	.hero-copy { max-width: 760px; }
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgba(125, 211, 252, 0.86);
	}
	.hero h1 {
		max-width: 11ch;
		margin-bottom: 1.1rem;
		font-size: clamp(3.25rem, 8vw, 6.4rem);
		line-height: 0.95;
		letter-spacing: -0.065em;
	}
	.lede {
		max-width: 42rem;
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.22rem);
		line-height: 1.55;
		color: rgba(226, 232, 240, 0.72);
	}
	.hero-actions {
		display: flex;
		gap: 1rem;
		margin-top: 1.6rem;
		flex-wrap: wrap;
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.2rem 0;
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.3;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}
	.button.primary { color: #e0f2fe; }
	.button.secondary { color: rgba(226, 232, 240, 0.68); }
	.lead-block,
	.briefing-grid,
	.categories-section {
		margin: 3rem 0 0;
	}
	.section-head.compact { margin-bottom: 1rem; }
	.section-head.split {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
	}
	.section-head h2 {
		font-size: clamp(1.45rem, 3vw, 2.1rem);
		letter-spacing: -0.045em;
	}
	.text-link {
		color: rgba(226, 232, 240, 0.72);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}
	.lead-story,
	.compact-card,
	.category-card {
		background: rgba(15, 23, 42, 0.34);
		border: 1px solid rgba(148, 163, 184, 0.12);
		border-radius: 0.75rem;
	}
	.lead-story {
		display: grid;
		grid-template-columns: minmax(10rem, 0.28fr) minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
		padding: 1.15rem 0;
		border-width: 1px 0;
		border-radius: 0;
		background: transparent;
	}
	.lead-story-copy { max-width: 48rem; }
	.lead-story h3 {
		max-width: 26ch;
		margin: 0 0 0.55rem;
		font-size: clamp(1.65rem, 3vw, 2.35rem);
		line-height: 1.06;
		overflow-wrap: anywhere;
		hyphens: auto;
	}
	.lead-story h3 a,
	.compact-card h3 a,
	.category-card h3 a {
		color: #f8fafc;
		text-decoration: none;
	}
	.lead-desc { max-width: 58ch; font-size: 1.02rem; }
	.post-grid.dense,
	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 0.75rem;
		align-items: stretch;
	}
	.compact-card,
	.category-card {
		min-height: 14.5rem;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.75rem;
		padding: 1rem;
		box-shadow: none;
	}
	.compact-card h3,
	.category-card h3 {
		max-width: none;
		margin: 0.25rem 0 0.4rem;
		font-size: clamp(1.02rem, 1.25vw, 1.14rem);
		line-height: 1.24;
		overflow-wrap: anywhere;
		hyphens: auto;
	}
	.category-card p:last-child { max-width: 62ch; }
	.meta {
		margin: 0;
		font-size: 0.72rem;
		color: rgba(186, 230, 253, 0.78);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.meta-row { display: flex; gap: 0.45rem; align-items: center; flex-wrap: wrap; }
	.meta-dot { color: rgba(148, 163, 184, 0.55); }
	.desc,
	.category-card p:last-child {
		margin: 0;
		max-width: 62ch;
		color: rgba(226, 232, 240, 0.68);
		font-size: 0.96rem;
		line-height: 1.52;
	}
	.compact-card .desc,
	.category-card p:last-child {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 4;
	}
	.category-count {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(125, 211, 252, 0.74);
	}
	@media (max-width: 720px) {
		.home-shell { padding-top: 1.5rem; }
		.hero { padding: 2.2rem 0 2.5rem; }
		.hero h1 { font-size: clamp(2.7rem, 14vw, 4.2rem); }
		.hero-actions { align-items: flex-start; flex-direction: row; }
		.section-head.split,
		.lead-story { display: block; }
		.text-link { display: inline-block; margin-top: 0.35rem; }
		.lead-kicker,
		.category-count { margin-bottom: 0.45rem; }
	}
</style>
