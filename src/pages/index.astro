---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
const [lead, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Global security / privacy / AI risk</p>
					<h1>Signal-first reporting on what changed, what broke, and what matters next.</h1>
					<p class="lede">
						ZeroDayDiary is a compact global journal tracking breaches, surveillance shifts,
						AI governance failures, and privacy-relevant policy changes.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">Latest briefings</a>
						<a class="button secondary" href="/search">Search archive</a>
					</div>
				</div>
				<div class="hero-rail">
					<div class="rail-card">
						<p class="panel-label">Desk rules</p>
						<ul>
							<li>Archive-first, not feed-first</li>
							<li>No email funnel or PII burden</li>
							<li>Reviewable Git-based publishing</li>
						</ul>
					</div>
				</div>
			</section>

			{lead && (
				<section class="lead-block">
					<div class="section-head split compact">
						<div>
							<p class="eyebrow">Lead briefing</p>
							<h2>Today’s starting point</h2>
						</div>
						<a class="text-link" href="/blog">Open archive →</a>
					</div>
					<article class="lead-story">
						<div class="lead-story-copy">
							<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
							<h3><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3>
							<p>{lead.data.description}</p>
							{lead.data.tags.length > 0 && <ul class="tag-list">{lead.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
						</div>
					</article>
				</section>
			)}

			<section class="briefing-grid">
				<div class="section-head compact">
					<p class="eyebrow">Recent briefings</p>
					<h2>New in the archive</h2>
				</div>
				<div class="post-grid dense">
					{rest.map((post) => (
						<article class="post-card compact-card">
							<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
							{post.data.tags.length > 0 && <ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
						</article>
					))}
				</div>
			</section>

			<section class="subscribe-strip tighter">
				<div>
					<p class="eyebrow">Operating model</p>
					<h2>Archive over audience capture.</h2>
					<p>
						The goal is a durable reference point for globally relevant security, privacy, and AI-risk events.
					</p>
				</div>
				<a class="button secondary" href="/categories">Browse categories</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell { width: min(1180px, calc(100% - 2rem)); max-width: none; padding: 1.4rem 0 4rem; }
	.hero { display:grid; grid-template-columns: 1.35fr 0.65fr; gap: 1rem; align-items: start; padding: 1.8rem 0 1.4rem; }
	.eyebrow { margin:0 0 .8rem; font-size:.76rem; text-transform:uppercase; letter-spacing:.18em; color:#22d3ee; }
	.hero h1 { font-size: clamp(2.5rem, 5vw, 4.4rem); line-height: .94; max-width: 13ch; margin-bottom: 1rem; }
	.lede { font-size: 1.06rem; max-width: 46rem; color: rgba(226,232,240,.76); }
	.hero-actions { display:flex; gap:.75rem; margin-top:1.35rem; flex-wrap:wrap; }
	.button { display:inline-flex; align-items:center; justify-content:center; padding:.85rem 1.15rem; border-radius:999px; text-decoration:none; font-weight:700; }
	.button.primary { background: linear-gradient(135deg, #06b6d4, #8b5cf6); color:#fff; box-shadow:0 16px 40px rgba(34,211,238,.16); }
	.button.secondary { border:1px solid rgba(148,163,184,.24); color:#e2e8f0; }
	.rail-card, .lead-story, .compact-card, .subscribe-strip { padding:1.1rem 1.15rem; border-radius:1.15rem; background:linear-gradient(180deg, rgba(15,23,42,.86), rgba(15,23,42,.64)); border:1px solid rgba(148,163,184,.12); box-shadow:0 18px 44px rgba(2,6,23,.25); }
	.rail-card ul { margin:0; padding-left:1rem; color:rgba(226,232,240,.74); }
	.panel-label { margin:0 0 .7rem; font-size:.75rem; letter-spacing:.14em; text-transform:uppercase; color:#93c5fd; }
	.section-head.compact { margin-bottom: .95rem; }
	.section-head.split { display:flex; justify-content:space-between; align-items:end; gap:1rem; }
	.text-link { text-decoration:none; font-weight:700; color:#a5f3fc; }
	.lead-block { margin: .6rem 0 2rem; }
	.lead-story-copy { max-width: 50rem; }
	.lead-story h3, .compact-card h3 { margin:.25rem 0 .45rem; }
	.lead-story h3 a, .compact-card h3 a { text-decoration:none; color:#f8fafc; }
	.briefing-grid { margin-top: 1rem; }
	.post-grid.dense { display:grid; grid-template-columns: repeat(3, 1fr); gap:.85rem; }
	.compact-card { min-height: 0; }
	.compact-card p { color: rgba(226,232,240,.72); }
	.meta { font-size:.82rem; color:#7dd3fc; margin-bottom:.25rem; }
	.tag-list { display:flex; flex-wrap:wrap; gap:.4rem; list-style:none; padding:0; margin:.85rem 0 0; }
	.tag-list li { font-size:.74rem; padding:.28rem .5rem; border-radius:999px; background:rgba(34,211,238,.12); color:#a5f3fc; }
	.subscribe-strip.tighter { margin-top: 2rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; background:linear-gradient(135deg, rgba(6,182,212,.08), rgba(139,92,246,.1)); }
	.subscribe-strip p { color: rgba(226,232,240,.74); }
	@media (max-width: 960px) {
		.hero, .post-grid.dense { grid-template-columns: 1fr; }
		.section-head.split, .subscribe-strip.tighter { flex-direction:column; align-items:flex-start; }
	}
</style>
