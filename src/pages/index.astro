---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORY_LIST, getPrimaryCategory, getTagTheme } from '../data/categories';

const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const cleanSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: estimateReadingTime(`${post.data.title} ${post.data.description} ${post.body}`),
	}));

const [lead, ...remaining] = allPosts;
const todaysBriefings = remaining.slice(0, 3);
const latestUpdates = remaining.slice(3, 9);
const categoryCounts = Object.fromEntries(
	CATEGORY_LIST.map((category) => [
		category.slug,
		allPosts.filter((post) => post.data.tags.includes(category.slug)).length,
	]),
);
const totalBriefings = allPosts.length;
const lastUpdated = allPosts[0]?.data.pubDate;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cybersecurity, Privacy & AI Risk Briefings | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent cybersecurity / privacy / AI risk journal</p>
					<h1>Signal over noise<span>Cybersecurity</span><span>Privacy</span><span>AI Risk</span></h1>
					<p class="lede">
						ZeroDayDiary tracks incidents, regulation, surveillance expansion, infrastructure pressure,
						and deployment failures across the digital risk landscape — with archive-first briefings built to stay useful after the news cycle moves on.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">Read latest briefings</a>
						<a class="button secondary" href="/search">Search archive</a>
						<a class="button secondary" href="/categories">Browse topics</a>
					</div>
					<div class="hero-metrics">
						<div class="metric-card">
							<span class="metric-label">Archive</span>
							<strong>{totalBriefings}</strong>
							<small>published briefings</small>
						</div>
						<div class="metric-card">
							<span class="metric-label">Coverage</span>
							<strong>{CATEGORY_LIST.length}</strong>
							<small>risk lanes</small>
						</div>
						<div class="metric-card">
							<span class="metric-label">Updated</span>
							<strong>{lastUpdated ? <FormattedDate date={lastUpdated} /> : '—'}</strong>
							<small>latest briefing</small>
						</div>
					</div>
				</div>
			</section>

			{lead && (
				<section class="lead-block">
					<div class="section-head split compact">
						<div>
							<p class="eyebrow">Lead briefing</p>
							<h2>Top of the desk</h2>
						</div>
						<a class="text-link" href="/blog">Open full archive →</a>
					</div>
					<article class="lead-story">
						<div class="lead-kicker">
							{(() => { const cat = getPrimaryCategory(lead.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
							<div class="meta-row">
								<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{lead.readingTime} min read</p>
							</div>
						</div>
						<div class="lead-story-copy">
							<h3><a href={`/blog/${cleanSlug(lead.id)}/`}>{lead.data.title}</a></h3>
							<p class="desc lead-desc">{lead.data.description}</p>
							{lead.data.tags.length > 0 && <ul class="tag-list">{lead.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>}
						</div>
					</article>
				</section>
			)}

			<section class="briefing-grid">
				<div class="section-head compact">
					<p class="eyebrow">Today’s briefings</p>
					<h2>Newest entries in the archive</h2>
				</div>
				<div class="post-grid dense three-up">
					{todaysBriefings.map((post) => (
						<article class="post-card compact-card">
							<div>
								{(() => { const cat = getPrimaryCategory(post.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${cleanSlug(post.id)}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
							{post.data.tags.length > 0 && <ul class="tag-list">{post.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>}
						</article>
					))}
				</div>
			</section>

			<section class="latest-updates">
				<div class="section-head compact">
					<p class="eyebrow">Latest updates</p>
					<h2>More briefings worth scanning</h2>
				</div>
				<div class="post-grid dense two-up">
					{latestUpdates.map((post) => (
						<article class="post-card compact-card subdued-card">
							<div>
								{(() => { const cat = getPrimaryCategory(post.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${cleanSlug(post.id)}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
							{post.data.tags.length > 0 && <ul class="tag-list">{post.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>}
						</article>
					))}
				</div>
			</section>

			<section class="categories-section">
				<div class="section-head split compact">
					<div>
						<p class="eyebrow">Topics</p>
						<h2>Track the archive by lane</h2>
					</div>
					<a class="text-link" href="/categories">View all topics →</a>
				</div>
				<div class="category-grid">
					{CATEGORY_LIST.map((category) => (
						<article class="category-card">
							<p class="category-count">{categoryCounts[category.slug]} entries</p>
							<h3><a href={`/categories/${category.slug}/`}>{category.title}</a></h3>
							<p>{category.description}</p>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell { width: min(1180px, calc(100% - 2rem)); max-width: none; padding: 1.25rem 0 4rem; }
	.hero {
		display:grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		align-items: stretch;
		padding: 1.4rem 0 1.2rem;
	}
	.eyebrow { margin:0 0 .8rem; font-size:.76rem; text-transform:uppercase; letter-spacing:.18em; color:#22d3ee; }
	.hero-copy, .hero-sidecard, .lead-story, .compact-card, .category-card {
		padding:1.15rem 1.2rem;
		border-radius:1.05rem;
		background:linear-gradient(180deg, rgba(15,23,42,.92), rgba(15,23,42,.72));
		border:1px solid rgba(148,163,184,.12);
		box-shadow:0 18px 44px rgba(2,6,23,.25);
	}
	.hero-copy {
		background:
			radial-gradient(circle at top left, rgba(34,211,238,.1), transparent 34%),
			radial-gradient(circle at 80% 10%, rgba(139,92,246,.12), transparent 28%),
			linear-gradient(180deg, rgba(10,16,30,.98), rgba(15,23,42,.86));
	}
	.hero h1 { font-size: clamp(2.55rem, 5vw, 4.55rem); line-height: .92; max-width: 12ch; margin-bottom: 1rem; display:grid; gap:.14em; }
	.hero h1 span { display:block; font-size: clamp(1.2rem, 2.1vw, 1.7rem); line-height:1; letter-spacing:-.02em; color:rgba(226,232,240,.9); }
	.lede { font-size: 1.05rem; max-width: 52rem; color: rgba(226,232,240,.8); }
	.hero-actions { display:flex; gap:.75rem; margin-top:1.35rem; flex-wrap:wrap; }
	.button { display:inline-flex; align-items:center; justify-content:center; padding:.88rem 1.15rem; border-radius:999px; text-decoration:none; font-weight:700; }
	.button.primary { background: linear-gradient(135deg, #06b6d4, #8b5cf6); color:#fff; box-shadow:0 16px 40px rgba(34,211,238,.16); }
	.button.secondary { border:1px solid rgba(148,163,184,.24); color:#e2e8f0; }
	.hero-metrics { display:grid; grid-template-columns: repeat(3, 1fr); gap:.7rem; margin-top:1.35rem; }
	.metric-card {
		padding:.85rem .9rem;
		border-radius:.9rem;
		background:rgba(2,6,23,.34);
		border:1px solid rgba(148,163,184,.12);
	}
	.metric-label { display:block; font-size:.68rem; text-transform:uppercase; letter-spacing:.14em; color:#7dd3fc; margin-bottom:.35rem; }
	.metric-card strong { display:block; color:#f8fafc; font-size:1.12rem; line-height:1.1; }
	.metric-card small { color:rgba(226,232,240,.6); font-size:.8rem; }
	.hero-sidecard h2 { font-size:1.4rem; line-height:1.02; margin-bottom:.8rem; }
	.hero-sidecard p { color:rgba(226,232,240,.76); }
	.panel-label { margin:0 0 .75rem; font-size:.74rem; text-transform:uppercase; letter-spacing:.14em; color:#93c5fd; }
	.desk-list { margin:1rem 0 0; padding-left:1rem; color:rgba(226,232,240,.74); }
	.desk-list li + li { margin-top:.45rem; }
	.section-head.compact { margin-bottom: 1rem; }
	.section-head.split { display:flex; justify-content:space-between; align-items:end; gap:1rem; }
	.text-link { text-decoration:none; font-weight:700; color:#a5f3fc; }
	.lead-block, .briefing-grid, .latest-updates, .categories-section { margin: 0 0 2rem; }
	.lead-story {
		display:grid;
		grid-template-columns: 1fr;
		gap:1rem;
		align-items:start;
		padding:1.2rem 1.25rem;
	}
	.lead-kicker {
		padding-right:0;
		padding-bottom:.8rem;
		border-right:none;
		border-bottom:1px solid rgba(148,163,184,.12);
		min-height:auto;
	}
	.lead-story-copy { max-width: 56rem; }
	.lead-story h3 { margin:.15rem 0 .55rem; font-size: clamp(1.85rem, 3vw, 2.55rem); line-height:1; max-width: 18ch; }
	.lead-story h3 a, .compact-card h3 a, .category-card h3 a { text-decoration:none; color:#f8fafc; }
	.lead-desc { font-size:1.04rem; max-width:62ch; }
	.compact-card h3, .category-card h3 { margin:.2rem 0 .5rem; }
	.compact-card h3 { font-size:1.16rem; line-height:1.12; max-width: 25ch; }
	.post-grid.dense, .category-grid { display:grid; gap:.85rem; }
	.post-grid.three-up { grid-template-columns: repeat(3, 1fr); }
	.post-grid.two-up { grid-template-columns: repeat(2, 1fr); }
	.category-grid { grid-template-columns: repeat(3, 1fr); }
	.compact-card, .category-card { min-height: 250px; }
	.compact-card { display:flex; flex-direction:column; justify-content:space-between; }
	.subdued-card { background:linear-gradient(180deg, rgba(15,23,42,.84), rgba(15,23,42,.62)); }
	.compact-card p, .category-card p { color: rgba(226,232,240,.72); }
	.meta { font-size:.78rem; color:#bae6fd; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }
	.meta-row { display:flex; gap:.55rem; align-items:center; flex-wrap:wrap; margin-bottom:.35rem; }
	.meta-dot { color: rgba(148,163,184,.7); }
	.desc { color: rgba(226,232,240,.8); line-height:1.58; font-size:.95rem; max-width:52ch; }
	.tag-list { display:flex; flex-wrap:wrap; gap:.45rem; list-style:none; padding:0; margin:1rem 0 0; }
	.tag-list li { font-size:.73rem; font-weight:700; padding:.32rem .55rem; border-radius:999px; border:1px solid; }
	.topic-chip { display:inline-block; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.22rem .52rem; border-radius:999px; border:1px solid; margin-bottom:.45rem; }
	.category-count { font-size:.74rem; letter-spacing:.12em; text-transform:uppercase; color:#7dd3fc; }
	@media (max-width: 1040px) {
		.hero { grid-template-columns: 1fr; }
		.lead-story { grid-template-columns: 1fr; }
		.lead-kicker { border-right:none; border-bottom:1px solid rgba(148,163,184,.12); padding-right:0; padding-bottom:.8rem; }
		.hero-metrics { grid-template-columns: repeat(3, minmax(0,1fr)); }
		.post-grid.three-up, .post-grid.two-up, .category-grid { grid-template-columns: 1fr 1fr; }
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: clamp(2rem, 10vw, 3rem); }
		.hero-metrics, .post-grid.three-up, .post-grid.two-up, .category-grid { grid-template-columns: 1fr; }
		.section-head.split { flex-direction:column; align-items:flex-start; }
	}
</style>
