---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORY_LIST } from '../data/categories';

const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const cleanSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: estimateReadingTime(`${post.data.title} ${post.data.description} ${post.body}`),
	}));

const [lead, ...remaining] = allPosts;
const todaysBriefings = remaining.slice(0, 3);
const categoryCounts = Object.fromEntries(
	CATEGORY_LIST.map((category) => [
		category.slug,
		allPosts.filter((post) => post.data.tags.includes(category.slug)).length,
	]),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cybersecurity, Privacy & AI Risk Briefings | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-shell">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent cybersecurity / privacy / AI risk journal</p>
					<h1>Signal over noise<span>Cybersecurity / Privacy / AI Risk</span></h1>
					<p class="lede">
						Tracking the cybersecurity, privacy, and AI risk signals that matter, beyond the headline breaches.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">Read latest briefings</a>
						<a class="button secondary" href="/search">Search archive</a>
						<a class="button secondary" href="/categories">Browse topics</a>
					</div>
				</div>
			</section>

			{lead && (
				<section class="lead-block">
					<div class="section-head split compact">
						<div>
							<p class="eyebrow">Lead briefing</p>
							<h2>Top of the desk</h2>
						</div>
						<a class="text-link" href="/blog">Open full archive →</a>
					</div>
					<article class="lead-story">
						<div class="lead-kicker">
							<div class="meta-row">
								<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{lead.readingTime} min read</p>
							</div>
						</div>
						<div class="lead-story-copy">
							<h3><a href={`/blog/${cleanSlug(lead.id)}/`}>{lead.data.title}</a></h3>
							<p class="desc lead-desc">{lead.data.description}</p>
						</div>
					</article>
				</section>
			)}

			<section class="briefing-grid">
				<div class="section-head compact">
					<p class="eyebrow">Today’s briefings</p>
					<h2>Newest entries in the archive</h2>
				</div>
				<div class="post-grid dense three-up">
					{todaysBriefings.map((post) => (
						<article class="post-card compact-card">
							<div>
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${cleanSlug(post.id)}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>


			<section class="categories-section">
				<div class="section-head split compact">
					<div>
						<p class="eyebrow">Topics</p>
						<h2>Browse by topic</h2>
					</div>
					<a class="text-link" href="/categories">View all topics →</a>
				</div>
				<div class="category-grid">
					{CATEGORY_LIST.map((category) => (
						<article class="category-card">
							<p class="category-count">{categoryCounts[category.slug]} entries</p>
							<h3><a href={`/categories/${category.slug}/`}>{category.title}</a></h3>
							<p>{category.description}</p>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-shell {
		width: min(980px, calc(100% - 2rem));
		max-width: none;
		padding: 2.5rem 0 4rem;
	}
	.hero {
		padding: 2.5rem 0 2.25rem;
		border-bottom: 1px solid rgba(148, 163, 184, 0.16);
	}
	.eyebrow {
		margin: 0 0 0.8rem;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #22d3ee;
	}
	.hero h1 {
		max-width: 12ch;
		margin-bottom: 1rem;
		font-size: clamp(3rem, 8vw, 5.6rem);
		line-height: 0.92;
	}
	.hero h1 span {
		display: block;
		margin-top: 0.55rem;
		font-size: clamp(1.35rem, 3vw, 2.1rem);
		line-height: 1.05;
		color: rgba(226, 232, 240, 0.86);
	}
	.lede {
		max-width: 46rem;
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.55;
		color: rgba(226, 232, 240, 0.76);
	}
	.hero-actions {
		display: flex;
		gap: 0.65rem;
		margin-top: 1.45rem;
		flex-wrap: wrap;
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.66rem 0.9rem;
		border-radius: 999px;
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
	}
	.button.primary {
		background: #22d3ee;
		color: #020617;
	}
	.button.secondary {
		border: 1px solid rgba(148, 163, 184, 0.26);
		color: #e2e8f0;
	}
	.lead-block,
	.briefing-grid,
	.categories-section {
		margin: 2.75rem 0 0;
	}
	.section-head.compact { margin-bottom: 1rem; }
	.section-head.split {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
	}
	.section-head h2 {
		font-size: clamp(1.8rem, 4vw, 2.7rem);
	}
	.text-link {
		color: #a5f3fc;
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
	}
	.lead-story,
	.compact-card,
	.category-card {
		padding: 1.15rem 0;
		border-top: 1px solid rgba(148, 163, 184, 0.14);
	}
	.lead-story {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}
	.lead-story-copy { max-width: 42rem; }
	.lead-story h3 {
		max-width: 19ch;
		margin: 0 0 0.55rem;
		font-size: clamp(1.8rem, 4vw, 2.55rem);
		line-height: 1.02;
	}
	.lead-story h3 a,
	.compact-card h3 a,
	.category-card h3 a {
		color: #f8fafc;
		text-decoration: none;
	}
	.lead-desc {
		max-width: 58ch;
		font-size: 1.02rem;
	}
	.post-grid.dense,
	.category-grid {
		display: grid;
		gap: 0;
	}
	.post-grid.three-up,
	.category-grid { grid-template-columns: 1fr; }
	.compact-card h3,
	.category-card h3 {
		max-width: 38rem;
		margin: 0.25rem 0 0.4rem;
		font-size: 1.35rem;
		line-height: 1.12;
	}
	.category-card {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: 1.25rem;
	}
	.category-card p:last-child {
		max-width: 56ch;
	}
	.meta {
		margin: 0;
		font-size: 0.73rem;
		color: #bae6fd;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.meta-row {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		flex-wrap: wrap;
	}
	.meta-dot { color: rgba(148, 163, 184, 0.7); }
	.desc {
		margin: 0;
		max-width: 56ch;
		color: rgba(226, 232, 240, 0.74);
		font-size: 0.98rem;
		line-height: 1.58;
	}
	.category-count {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #7dd3fc;
	}
	@media (max-width: 720px) {
		.home-shell { padding-top: 1.5rem; }
		.hero { padding-top: 1.4rem; }
		.hero h1 { font-size: clamp(2.5rem, 14vw, 4rem); }
		.hero-actions { align-items: stretch; flex-direction: column; }
		.button { width: 100%; }
		.section-head.split,
		.lead-story,
		.category-card {
			display: block;
		}
		.text-link { display: inline-block; margin-top: 0.35rem; }
		.lead-kicker,
		.category-count { margin-bottom: 0.45rem; }
	}
</style>
