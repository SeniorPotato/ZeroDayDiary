---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getTagTheme } from '../data/categories';
import { applyLandscapeFilters, getGeoLabel, getRenderableMarkers, normalizeLandscapePosts } from '../lib/landscape';

const allPosts = normalizeLandscapePosts(await getCollection('blog', ({ data }) => !data.draft));
const filters = {
	query: Astro.url.searchParams.get('q') ?? '',
	category: Astro.url.searchParams.get('category'),
	country: Astro.url.searchParams.get('country'),
	region: Astro.url.searchParams.get('region'),
};
const posts = applyLandscapeFilters(allPosts, filters);
const markers = getRenderableMarkers(posts);
const categories = [...new Set(allPosts.map((post) => post.categories[0]))].sort();
const countries = [...new Set(allPosts.flatMap((post) => post.geo?.countries ?? []))].sort();
const regions = [...new Set(allPosts.flatMap((post) => (post.geo?.region ? [post.geo.region] : [])))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cyber Landscape | ${SITE_TITLE}`} description="Track ZeroDayDiary posts by geography through a mapped editorial chronicle." />
	</head>
	<body>
		<Header />
		<main class="landscape-shell">
			<section class="hero-card">
				<p class="eyebrow">Cyber Landscape</p>
				<h1>A geographic chronicle of cyber, privacy, and policy movement.</h1>
				<p class="lede">Track cybersecurity, privacy, regulation, and digital conflict by geography — with mapped posts linked back to the editorial archive.</p>
				<div class="counts">
					<div><strong>{posts.length}</strong><span>posts shown</span></div>
					<div><strong>{markers.length}</strong><span>mapped locations</span></div>
				</div>
			</section>

			<form class="filters" method="get">
				<input type="search" name="q" value={filters.query} placeholder="Search title, summary, tags" />
				<select name="category">
					<option value="">All categories</option>
					{categories.map((category) => <option value={category} selected={filters.category === category}>{category}</option>)}
				</select>
				<select name="country">
					<option value="">All countries</option>
					{countries.map((country) => <option value={country} selected={filters.country === country}>{country}</option>)}
				</select>
				<select name="region">
					<option value="">All regions</option>
					{regions.map((region) => <option value={region} selected={filters.region === region}>{region}</option>)}
				</select>
				<div class="filter-actions">
					<button type="submit">Apply</button>
					<a href="/cyber-landscape">Reset</a>
				</div>
			</form>

			<section class="map-placeholder">
				<div class="section-head">
					<div>
						<p class="eyebrow">Slice 1</p>
						<h2>Map foundation is ready next</h2>
					</div>
				</div>
				<p>This first slice ships the schema, geo metadata foundation, filters, and the feed-only landscape view. The interactive map layer comes next once we wire Leaflet onto the normalized post dataset.</p>
			</section>

			<section class="timeline-section">
				<div class="section-head split">
					<div>
						<p class="eyebrow">Chronicle</p>
						<h2>Filtered archive feed</h2>
					</div>
					<p class="subcopy">Mapped, regional, and global stories stay visible here even before the map ships.</p>
				</div>
				<div class="timeline-grid">
					{posts.map((post) => (
						<article class="timeline-card">
							<div>
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.date} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{getGeoLabel(post.geo)}</p>
								</div>
								<h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
								<p class="desc">{post.summary}</p>
							</div>
							<ul class="tag-list">
								{post.tags.map((tag) => {
									const theme = getTagTheme(tag);
									return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>;
								})}
							</ul>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.landscape-shell { width: min(1180px, calc(100% - 2rem)); max-width: none; padding: 1.25rem 0 4rem; }
	.hero-card, .filters, .map-placeholder, .timeline-card {
		padding: 1.15rem 1.2rem;
		border-radius: 1.05rem;
		background: linear-gradient(180deg, rgba(15,23,42,.92), rgba(15,23,42,.72));
		border: 1px solid rgba(148,163,184,.12);
		box-shadow: 0 18px 44px rgba(2,6,23,.25);
	}
	.hero-card {
		background:
			radial-gradient(circle at top left, rgba(34,211,238,.1), transparent 34%),
			radial-gradient(circle at 80% 10%, rgba(139,92,246,.12), transparent 28%),
			linear-gradient(180deg, rgba(10,16,30,.98), rgba(15,23,42,.86));
		margin-bottom: 1rem;
	}
	.eyebrow { margin:0 0 .8rem; font-size:.76rem; text-transform:uppercase; letter-spacing:.18em; color:#22d3ee; }
	h1 { font-size: clamp(2.2rem, 4vw, 3.5rem); line-height: .96; margin: 0 0 .8rem; max-width: 14ch; }
	.lede, .map-placeholder p, .subcopy, .desc { color: rgba(226,232,240,.78); }
	.counts { display:flex; gap:.8rem; flex-wrap:wrap; margin-top:1rem; }
	.counts div { padding:.75rem .9rem; border-radius:.85rem; background:rgba(2,6,23,.34); border:1px solid rgba(148,163,184,.12); }
	.counts strong { display:block; color:#f8fafc; font-size:1.1rem; }
	.counts span { font-size:.8rem; color:rgba(226,232,240,.62); }
	.filters {
		display:grid;
		grid-template-columns: 2fr repeat(3, minmax(0, 1fr)) auto;
		gap:.7rem;
		margin-bottom: 1rem;
	}
	.filters input, .filters select, .filters button, .filters a {
		min-height: 2.8rem;
		border-radius: .8rem;
		border: 1px solid rgba(148,163,184,.18);
		background: rgba(2,6,23,.35);
		color: #f8fafc;
		padding: 0 .85rem;
		font: inherit;
		text-decoration: none;
		display:flex;
		align-items:center;
	}
	.filters button { cursor:pointer; justify-content:center; font-weight:700; }
	.filter-actions { display:flex; gap:.7rem; }
	.map-placeholder { margin-bottom: 1rem; }
	.section-head.split { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1rem; }
	.timeline-grid { display:grid; grid-template-columns: repeat(2, 1fr); gap:.85rem; }
	.timeline-card { min-height: 220px; display:flex; flex-direction:column; justify-content:space-between; }
	.timeline-card h3 { margin:.15rem 0 .5rem; font-size:1.16rem; line-height:1.12; }
	.timeline-card h3 a { text-decoration:none; color:#f8fafc; }
	.meta-row { display:flex; gap:.55rem; align-items:center; flex-wrap:wrap; margin-bottom:.35rem; }
	.meta { font-size:.78rem; color:#bae6fd; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }
	.meta-dot { color: rgba(148,163,184,.7); }
	.tag-list { display:flex; flex-wrap:wrap; gap:.45rem; list-style:none; padding:0; margin:1rem 0 0; }
	.tag-list li { font-size:.73rem; font-weight:700; padding:.32rem .55rem; border-radius:999px; border:1px solid; }
	@media (max-width: 960px) {
		.filters { grid-template-columns: 1fr 1fr; }
		.timeline-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 720px) {
		.filters { grid-template-columns: 1fr; }
		.section-head.split { flex-direction:column; align-items:flex-start; }
	}
</style>
