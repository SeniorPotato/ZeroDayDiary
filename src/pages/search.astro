---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { CATEGORY_LIST } from '../data/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    tags: post.data.tags,
  }));
const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Search | ${SITE_TITLE}`} description="Search and filter the ZeroDayDiary archive." />
    <style>
      main { width: min(1180px, calc(100% - 2rem)); max-width: none; }
      .page-head { margin: .8rem 0 1.5rem; }
      .eyebrow { margin:0 0 .7rem; font-size:.76rem; text-transform:uppercase; letter-spacing:.18em; color:#22d3ee; }
      .page-head p { max-width: 48rem; color: rgba(226,232,240,0.74); }
      .layout { display: grid; grid-template-columns: 320px 1fr; gap: .9rem; align-items: start; }
      .panel, .result-card, .empty-state {
        padding: 1.05rem 1.1rem;
        border-radius: 1.05rem;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.68));
        border: 1px solid rgba(148, 163, 184, 0.12);
        box-shadow: 0 18px 44px rgba(2, 6, 23, 0.25);
      }
      .panel { position: sticky; top: 5.5rem; }
      .results { display: grid; gap: .85rem; }
      .section-label { margin: 1rem 0 .6rem; font-size: .74rem; text-transform: uppercase; letter-spacing: .14em; color: #93c5fd; }
      label { display:block; margin-bottom:.45rem; color:#e2e8f0; font-weight:700; }
      input[type="search"] {
        width: 100%; padding: 0.9rem 0.95rem; border-radius: 0.85rem; border: 1px solid rgba(148, 163, 184, 0.2);
        background: rgba(2,6,23,0.55); color: #f8fafc;
      }
      input[type="search"]::placeholder { color: rgba(226,232,240,0.44); }
      .helper { margin:.55rem 0 0; color: rgba(226,232,240,0.62); font-size:.88rem; }
      .pill-list { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.6rem; }
      .pill {
        border: 1px solid rgba(34,211,238,0.18); background: rgba(34,211,238,0.1); color: #a5f3fc;
        padding: 0.38rem 0.62rem; border-radius: 999px; cursor: pointer; font-size: 0.78rem;
      }
      .pill.active { background: rgba(34,211,238,0.22); color: #ecfeff; border-color: rgba(103,232,249,.38); }
      .toolbar { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom: .85rem; }
      .count { color: rgba(226,232,240,0.72); }
      .clear-button {
        border: 1px solid rgba(148, 163, 184, 0.18); background: transparent; color: #e2e8f0;
        padding: 0.5rem 0.8rem; border-radius: 999px; cursor: pointer; font-size: .82rem;
      }
      .clear-button[hidden] { display:none; }
      .result-card h2 { margin: 0.25rem 0 0.45rem; font-size: 1.28rem; line-height:1.05; }
      .result-card a { text-decoration: none; color: #f8fafc; }
      .result-card p { color: rgba(226,232,240,0.74); }
      .meta { color: #7dd3fc; font-size: 0.8rem; }
      .tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.85rem 0 0; }
      .tag-list li { font-size: 0.72rem; padding: 0.28rem 0.48rem; border-radius: 999px; background: rgba(34,211,238,0.12); color: #a5f3fc; }
      .empty-state { display:none; }
      .empty-state h2 { margin:.15rem 0 .45rem; }
      .empty-state p { color: rgba(226,232,240,0.74); }
      .text-link { text-decoration:none; color:#a5f3fc; font-weight:700; }
      @media (max-width: 960px) {
        .layout { grid-template-columns: 1fr; }
        .panel { position: static; }
        .toolbar { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="page-head">
        <p class="eyebrow">Archive tools</p>
        <h1>Search and filter</h1>
        <p>Find briefings by keyword, reporting lane, or recurring tag. Search stays local to the static archive and is designed for quick scanning rather than full-text clutter.</p>
      </section>
      <section class="layout">
        <aside class="panel">
          <label for="searchBox">Keyword</label>
          <input id="searchBox" type="search" placeholder="Search headlines, descriptions, tags…" />
          <p class="helper">Try a ransomware family, regulator name, sector, or tag.</p>

          <div>
            <p class="section-label">Categories</p>
            <div class="pill-list" id="categoryFilters">
              {CATEGORY_LIST.map((category) => <button type="button" class="pill" data-filter={category.slug}>{category.title}</button>)}
            </div>
          </div>

          <div>
            <p class="section-label">Tags</p>
            <div class="pill-list" id="tagFilters">
              {allTags.map((tag) => <button type="button" class="pill" data-filter={tag}>{tag}</button>)}
            </div>
          </div>
        </aside>

        <div>
          <div class="toolbar">
            <p class="count" id="resultCount"></p>
            <button type="button" class="clear-button" id="clearFilters" hidden>Clear filters</button>
          </div>
          <section class="results" id="results">
            {posts.map((post) => (
              <article class="result-card" data-title={post.title.toLowerCase()} data-description={post.description.toLowerCase()} data-tags={post.tags.join(' ').toLowerCase()}>
                <p class="meta"><FormattedDate date={post.pubDate} /></p>
                <h2><a href={`/blog/${post.id}/`}>{post.title}</a></h2>
                <p>{post.description}</p>
                <ul class="tag-list">{post.tags.map((tag) => <li>{tag}</li>)}</ul>
              </article>
            ))}
          </section>
          <section class="empty-state" id="emptyState">
            <p class="eyebrow">No matches</p>
            <h2>No briefings matched that combination.</h2>
            <p>Try removing a tag filter, switching category, or broadening the keyword. You can also return to the <a class="text-link" href="/blog">full archive</a>.</p>
          </section>
        </div>
      </section>
    </main>

    <Footer />
    <script is:inline src="/search.js"></script>
  </body>
</html>
