---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPrimaryCategory, getTagTheme } from '../../data/categories';

const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const cleanSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: estimateReadingTime(`${post.data.title} ${post.data.description} ${post.body}`),
	}));
const [lead, ...rest] = posts;
const latestDate = posts[0]?.data.pubDate;
const totalBriefings = posts.length;
const latestBatch = rest.slice(0, 4);
const archiveRemainder = rest.slice(4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cybersecurity, Privacy & AI Risk Briefings | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: min(1180px, calc(100% - 2rem)); max-width: none; }
			.header-copy { margin: .8rem 0 1.8rem; }
			.header-copy p { max-width: 50rem; color: rgba(226,232,240,0.74); }
			.archive-summary {
				display:grid;
				grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
				gap:.9rem;
				margin: 0 0 1.4rem;
			}
			.archive-intro, .archive-sidecar, .lead-card, .post-card {
				background: linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.7));
				border: 1px solid rgba(148, 163, 184, 0.14);
				border-radius: 1.05rem;
				overflow: hidden;
				box-shadow: 0 18px 44px rgba(2, 6, 23, 0.26);
			}
			.archive-intro {
				padding: 1.25rem 1.3rem;
				background:
					radial-gradient(circle at top left, rgba(34,211,238,.08), transparent 34%),
					radial-gradient(circle at 85% 12%, rgba(139,92,246,.1), transparent 28%),
					linear-gradient(180deg, rgba(10,16,30,.98), rgba(15,23,42,.86));
			}
			.archive-sidecar {
				padding: 1.15rem 1.2rem;
				display:grid;
				gap:.8rem;
				align-content:start;
			}
			.archive-metrics { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:.7rem; }
			.metric-card {
				padding:.85rem .9rem;
				border-radius:.9rem;
				background:rgba(2,6,23,.34);
				border:1px solid rgba(148,163,184,.12);
			}
			.metric-card strong { display:block; color:#f8fafc; font-size:1.1rem; line-height:1.1; }
			.metric-card small, .archive-sidecar p { color:rgba(226,232,240,.72); }
			.sidecar-label { margin:0; font-size:.72rem; text-transform:uppercase; letter-spacing:.16em; color:#7dd3fc; }
			.lead-card { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr); }
			.lead-copy { padding: 1.35rem; }
			.lead-copy h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin: 0 0 0.55rem; max-width: 18ch; line-height:1.03; overflow-wrap:anywhere; hyphens:auto; }
			.lead-copy a, .post-card a { text-decoration: none; color: #f8fafc; }
			.lead-copy p, .post-card p { color: rgba(226,232,240,0.8); }
			.lead-media img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
			.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: .95rem; align-items: stretch; }
			.post-card { padding: 1rem 1.05rem; min-height: 18rem; height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; }
			.post-card h3 { margin: .2rem 0 .5rem; font-size: clamp(1.05rem, 1.4vw, 1.22rem); line-height:1.2; max-width: none; overflow-wrap:anywhere; hyphens:auto; }
			.post-card .desc { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; font-size: .95rem; line-height: 1.5; max-width: 62ch; }
			.meta { color: #bae6fd; font-size: 0.78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
			.meta-row { display:flex; gap:.55rem; align-items:center; flex-wrap:wrap; margin-bottom:.35rem; }
			.meta-dot { color: rgba(148,163,184,.7); }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; padding: 0; margin: auto 0 0; }
			.tag-list li { font-size: 0.73rem; font-weight:700; padding: 0.32rem 0.55rem; border-radius: 999px; border: 1px solid; }
			.archive-label { display: flex; align-items: center; gap: 0.55rem; margin-bottom: .8rem; color: #93c5fd; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.74rem; }
			.archive-label::before { content: ''; width: 2rem; height: 1px; background: rgba(34,211,238,0.6); }
			.text-link { text-decoration:none; color:#a5f3fc; font-weight:700; }
			.lead-copy .desc { font-size: 1rem; line-height: 1.62; max-width: 56ch; }
			.section-head { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin:0 0 1rem; }
			.section-head p { margin:0; }
			.section-kicker { margin:0 0 .45rem; font-size:.74rem; text-transform:uppercase; letter-spacing:.16em; color:#7dd3fc; }
			@media (max-width: 900px) {
				.archive-summary, .lead-card, .grid { grid-template-columns: 1fr; }
				.section-head { flex-direction:column; align-items:flex-start; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="header-copy">
				<div class="archive-label">Archive / briefings</div>
				<h1>Cybersecurity, privacy, and AI risk briefings</h1>
				<p>Structured reporting on cybersecurity incidents, privacy harms, governance shifts, and AI operational risk — designed to be scanned quickly and revisited later.</p>
			</section>
			<section class="archive-summary">
				<div class="archive-intro">
					<p class="section-kicker">How to use the archive</p>
					<h2>Start with the lead, then scan the newest movement across the archive.</h2>
					<p>The archive is arranged to surface the clearest current signal first, then give you a fast read on what else has shifted across security, privacy, governance, infrastructure, surveillance, and AI risk.</p>
					<p><a class="text-link" href="/search">Need something specific? Use search and filtering →</a></p>
				</div>
				<aside class="archive-sidecar">
					<p class="sidecar-label">Archive snapshot</p>
					<div class="archive-metrics">
						<div class="metric-card">
							<strong>{totalBriefings}</strong>
							<small>published briefings</small>
						</div>
						<div class="metric-card">
							<strong>{latestBatch.length}</strong>
							<small>fresh items in focus</small>
						</div>
						<div class="metric-card">
							<strong>{latestDate ? <FormattedDate date={latestDate} /> : '—'}</strong>
							<small>latest publication date</small>
						</div>
						<div class="metric-card">
							<strong>{archiveRemainder.length}</strong>
							<small>additional archive entries</small>
						</div>
					</div>
					<p>Use the category chips for quick orientation, then the tag trail when you want to follow narrower patterns across the archive.</p>
				</aside>
			</section>
			{lead && (
				<section class="hero-listing">
					<article class="lead-card">
						<div class="lead-copy">
							<div class="meta-row">
								<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{lead.readingTime} min read</p>
							</div>
							<h2><a href={`/blog/${cleanSlug(lead.id)}/`}>{lead.data.title}</a></h2>
							<p class="desc">{lead.data.description}</p>
							{lead.data.tags.length > 0 && (
								<ul class="tag-list">{lead.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>
							)}
						</div>
						{lead.data.heroImage && (
							<div class="lead-media"><Image width={900} height={620} src={lead.data.heroImage} alt="" /></div>
						)}
					</article>
				</section>
			)}
			<section>
				<div class="section-head">
					<div>
						<p class="section-kicker">Newest movement</p>
						<h2>Recent briefings across the archive</h2>
					</div>
					<a class="text-link" href="/categories">Browse by category →</a>
				</div>
				<div class="grid">
					{rest.map((post) => (
						<article class="post-card">
							<div>
								<div class="meta-row">
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<span class="meta-dot">•</span>
									<p class="meta">{post.readingTime} min read</p>
								</div>
								<h3><a href={`/blog/${cleanSlug(post.id)}/`}>{post.data.title}</a></h3>
								<p class="desc">{post.data.description}</p>
							</div>
							{post.data.tags.length > 0 && (
								<ul class="tag-list">{post.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>
							)}
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
