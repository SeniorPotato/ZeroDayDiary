---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPrimaryCategory, getTagTheme } from '../../data/categories';

const estimateReadingTime = (text: string) => Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
const cleanSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		...post,
		readingTime: estimateReadingTime(`${post.data.title} ${post.data.description} ${post.body}`),
	}));
const [lead, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Briefings | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: min(1180px, calc(100% - 2rem)); max-width: none; }
			.header-copy { margin: .8rem 0 1.8rem; }
			.header-copy p { max-width: 50rem; color: rgba(226,232,240,0.74); }
			.hero-listing { margin: 0 0 1.4rem; }
			.lead-card, .post-card {
				background: linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.7));
				border: 1px solid rgba(148, 163, 184, 0.14);
				border-radius: 1.05rem;
				overflow: hidden;
				box-shadow: 0 18px 44px rgba(2, 6, 23, 0.26);
			}
			.lead-card { display: grid; grid-template-columns: 1.1fr .9fr; }
			.lead-copy { padding: 1.35rem; }
			.lead-copy h2 { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 0.55rem; max-width: 13ch; line-height:.98; }
			.lead-copy a, .post-card a { text-decoration: none; color: #f8fafc; }
			.lead-copy p, .post-card p { color: rgba(226,232,240,0.8); }
			.lead-media img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
			.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .85rem; }
			.post-card { padding: 1rem 1.05rem; min-height: 250px; display: flex; flex-direction: column; justify-content: space-between; }
			.post-card h3 { margin: .2rem 0 .5rem; font-size: 1.16rem; line-height:1.12; max-width: 26ch; }
			.post-card .desc { font-size: .95rem; line-height: 1.58; max-width: 52ch; }
			.topic-chip { display:inline-block; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.22rem .52rem; border-radius:999px; border:1px solid; margin-bottom:.45rem; }
			.meta { color: #bae6fd; font-size: 0.78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
			.meta-row { display:flex; gap:.55rem; align-items:center; flex-wrap:wrap; margin-bottom:.35rem; }
			.meta-dot { color: rgba(148,163,184,.7); }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; padding: 0; margin: 1rem 0 0; }
			.tag-list li { font-size: 0.73rem; font-weight:700; padding: 0.32rem 0.55rem; border-radius: 999px; border: 1px solid; }
			.lead-copy .topic-chip { margin-top: .1rem; }
			.archive-label { display: flex; align-items: center; gap: 0.55rem; margin-bottom: .8rem; color: #93c5fd; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.74rem; }
			.archive-label::before { content: ''; width: 2rem; height: 1px; background: rgba(34,211,238,0.6); }
			.topic-chip { display:inline-block; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.22rem .52rem; border-radius:999px; border:1px solid; margin-bottom:.45rem; }
			.text-link { text-decoration:none; color:#a5f3fc; font-weight:700; }
			.lead-copy .desc { font-size: 1rem; line-height: 1.62; max-width: 56ch; }
			@media (max-width: 1080px) { .grid { grid-template-columns: repeat(2, 1fr); } }
			@media (max-width: 900px) {
				.lead-card, .grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="header-copy">
				<div class="archive-label">Archive / briefings</div>
				<h1>Briefings and field notes</h1>
				<p>Structured reporting on cybersecurity incidents, privacy harms, platform governance, and AI operational risk — designed to be scanned quickly and revisited later.</p>
				<p><a class="text-link" href="/search">Need something specific? Use search and filtering →</a></p>
			</section>
			{lead && (
				<section class="hero-listing">
					<article class="lead-card">
						<div class="lead-copy">
							{(() => { const cat = getPrimaryCategory(lead.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
							<div class="meta-row">
								<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{lead.readingTime} min read</p>
							</div>
							<h2><a href={`/blog/${cleanSlug(lead.id)}/`}>{lead.data.title}</a></h2>
							<p class="desc">{lead.data.description}</p>
							{lead.data.tags.length > 0 && (
								<ul class="tag-list">{lead.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>
							)}
						</div>
						{lead.data.heroImage && (
							<div class="lead-media"><Image width={900} height={620} src={lead.data.heroImage} alt="" /></div>
						)}
					</article>
				</section>
			)}
			<section class="grid">
				{rest.map((post) => (
					<article class="post-card">
						<div>
							{(() => { const cat = getPrimaryCategory(post.data.tags); return <span class="topic-chip" style={`color:${cat.color};background:${cat.chipBackground};border-color:${cat.color}33`}>{cat.title}</span>; })()}
							<div class="meta-row">
								<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
								<span class="meta-dot">•</span>
								<p class="meta">{post.readingTime} min read</p>
							</div>
							<h3><a href={`/blog/${cleanSlug(post.id)}/`}>{post.data.title}</a></h3>
							<p class="desc">{post.data.description}</p>
						</div>
						{post.data.tags.length > 0 && (
							<ul class="tag-list">{post.data.tags.map((tag) => { const theme = getTagTheme(tag); return <li style={`color:${theme.color};background:${theme.chipBackground};border-color:${theme.color}33`}>{tag}</li>; })}</ul>
						)}
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
