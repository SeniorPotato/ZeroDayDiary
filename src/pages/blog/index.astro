---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [lead, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Briefings | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: min(1180px, calc(100% - 2rem)); max-width: none; }
			.header-copy { margin: .8rem 0 1.8rem; }
			.header-copy p { max-width: 50rem; color: rgba(226,232,240,0.74); }
			.hero-listing { margin: 0 0 1.4rem; }
			.lead-card, .post-card {
				background: linear-gradient(180deg, rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.68));
				border: 1px solid rgba(148, 163, 184, 0.14);
				border-radius: 1.05rem;
				overflow: hidden;
				box-shadow: 0 18px 44px rgba(2, 6, 23, 0.26);
			}
			.lead-card { display: grid; grid-template-columns: 1.1fr .9fr; }
			.lead-copy { padding: 1.35rem; }
			.lead-copy h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 0.6rem; max-width: 14ch; line-height:.98; }
			.lead-copy a, .post-card a { text-decoration: none; color: #f8fafc; }
			.lead-copy p, .post-card p { color: rgba(226,232,240,0.74); }
			.lead-media img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
			.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .85rem; }
			.post-card { padding: 1rem 1.05rem; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; }
			.post-card h3 { margin: .3rem 0 .45rem; font-size: 1.28rem; line-height:1.05; }
			.meta { color: #7dd3fc; font-size: 0.8rem; }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.85rem 0 0; }
			.tag-list li { font-size: 0.72rem; padding: 0.28rem 0.48rem; border-radius: 999px; background: rgba(34,211,238,0.12); color: #a5f3fc; }
			.archive-label { display: flex; align-items: center; gap: 0.55rem; margin-bottom: .8rem; color: #93c5fd; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.74rem; }
			.archive-label::before { content: ''; width: 2rem; height: 1px; background: rgba(34,211,238,0.6); }
			.text-link { text-decoration:none; color:#a5f3fc; font-weight:700; }
			@media (max-width: 900px) {
				.lead-card, .grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="header-copy">
				<div class="archive-label">Archive / briefings</div>
				<h1>Briefings and field notes</h1>
				<p>Structured reporting on cybersecurity incidents, privacy harms, platform governance, and AI operational risk — designed to be scanned quickly and revisited later.</p>
				<p><a class="text-link" href="/search">Need something specific? Use search and filtering →</a></p>
			</section>
			{lead && (
				<section class="hero-listing">
					<article class="lead-card">
						<div class="lead-copy">
							<p class="meta"><FormattedDate date={lead.data.pubDate} /></p>
							<h2><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h2>
							<p>{lead.data.description}</p>
							{lead.data.tags.length > 0 && (
								<ul class="tag-list">{lead.data.tags.map((tag) => <li>{tag}</li>)}</ul>
							)}
						</div>
						{lead.data.heroImage && (
							<div class="lead-media"><Image width={900} height={620} src={lead.data.heroImage} alt="" /></div>
						)}
					</article>
				</section>
			)}
			<section class="grid">
				{rest.map((post) => (
					<article class="post-card">
						<div>
							<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
							<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
							<p>{post.data.description}</p>
						</div>
						{post.data.tags.length > 0 && (
							<ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
						)}
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
