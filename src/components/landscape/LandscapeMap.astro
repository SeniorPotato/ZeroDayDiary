---
import type { RenderableMarker } from '../../lib/landscape';

interface Props {
	markers: RenderableMarker[];
}

const { markers } = Astro.props;
const markerPayload = JSON.stringify(markers);
---

<link
	rel="stylesheet"
	href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
	integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
	crossorigin=""
/>

<section class="map-card">
	<div class="map-head">
		<div>
			<p class="eyebrow">Map</p>
			<h2>Live geography view</h2>
		</div>
		<p class="subcopy">Pins are generated from the geo metadata added to the archive. Click a marker to open the related briefing.</p>
	</div>
	<div id="landscape-map" class="map-canvas" data-markers={markerPayload}></div>
</section>

<script>
	const markerColors = {
		security: '#22d3ee',
		privacy: '#a78bfa',
		'ai-risk': '#f59e0b',
		governance: '#94a3b8',
		infrastructure: '#38bdf8',
		surveillance: '#cbd5e1',
	};

	function createMarkerIcon(color) {
		return window.L.divIcon({
			className: 'landscape-marker-shell',
			html: `<span class="landscape-marker" style="--marker:${color}"></span>`,
			iconSize: [18, 18],
			iconAnchor: [9, 9],
		});
	}

	async function ensureLeaflet() {
		if (window.L) return window.L;
		await new Promise((resolve, reject) => {
			const script = document.createElement('script');
			script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
			script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
			script.crossOrigin = '';
			script.onload = resolve;
			script.onerror = reject;
			document.head.appendChild(script);
		});
		return window.L;
	}

	async function initLandscapeMap() {
		const el = document.getElementById('landscape-map');
		if (!el || el.dataset.ready === 'true') return;
		el.dataset.ready = 'true';
		const markers = JSON.parse(el.dataset.markers || '[]');
		const L = await ensureLeaflet();

		const map = L.map(el, {
			worldCopyJump: true,
			attributionControl: true,
			minZoom: 1.4,
			maxZoom: 6,
			zoomSnap: 0.25,
		});

		L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
			attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
			subdomains: 'abcd',
			maxZoom: 19,
		}).addTo(map);

		const bounds = [];
		markers.forEach((marker) => {
			const color = markerColors[marker.category] || '#22d3ee';
			const leafletMarker = L.marker([marker.lat, marker.lng], { icon: createMarkerIcon(color), keyboard: true }).addTo(map);
			leafletMarker.bindPopup(`
				<div class="landscape-popup">
					<p class="landscape-popup-kicker">${marker.category}</p>
					<h3>${marker.title}</h3>
					<p>${marker.pointName}</p>
					<a href="/blog/${marker.slug}/">Open briefing</a>
				</div>
			`);
			leafletMarker.on('click', () => {
				window.location.href = `/blog/${marker.slug}/`;
			});
			bounds.push([marker.lat, marker.lng]);
		});

		if (bounds.length === 1) {
			map.setView(bounds[0], 3);
		} else if (bounds.length > 1) {
			map.fitBounds(bounds, { padding: [28, 28] });
		} else {
			map.setView([20, 5], 1.6);
		}
	}

	initLandscapeMap();
	document.addEventListener('astro:page-load', initLandscapeMap);
</script>

<style>
	.map-card {
		padding: 1.15rem 1.2rem;
		border-radius: 1.05rem;
		background: linear-gradient(180deg, rgba(15,23,42,.92), rgba(15,23,42,.72));
		border: 1px solid rgba(148,163,184,.12);
		box-shadow: 0 18px 44px rgba(2,6,23,.25);
		margin-bottom: 1rem;
	}
	.map-head {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.map-head h2 { margin: 0; }
	.map-head .eyebrow { margin-bottom: .45rem; }
	.map-canvas {
		height: 31rem;
		border-radius: .95rem;
		overflow: hidden;
		border: 1px solid rgba(148,163,184,.14);
		background: #0b1120;
	}
	:global(.landscape-marker-shell) {
		background: transparent;
		border: 0;
	}
	:global(.landscape-marker) {
		display: block;
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--marker);
		border: 2px solid rgba(248,250,252,.95);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--marker) 22%, transparent), 0 8px 18px rgba(2,6,23,.45);
	}
	:global(.landscape-popup) {
		font-family: Arial, sans-serif;
		color: #0f172a;
		min-width: 14rem;
	}
	:global(.landscape-popup-kicker) {
		margin: 0 0 .25rem;
		font-size: .68rem;
		text-transform: uppercase;
		letter-spacing: .12em;
		color: #475569;
		font-weight: 700;
	}
	:global(.landscape-popup h3) {
		margin: 0 0 .35rem;
		font-size: .95rem;
		line-height: 1.25;
	}
	:global(.landscape-popup p) {
		margin: 0 0 .55rem;
		font-size: .82rem;
		color: #475569;
	}
	:global(.landscape-popup a) {
		font-size: .82rem;
		font-weight: 700;
		color: #0f172a;
		text-decoration: none;
	}
	@media (max-width: 720px) {
		.map-head { flex-direction: column; align-items: flex-start; }
		.map-canvas { height: 22rem; }
	}
</style>
