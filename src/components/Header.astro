---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav>
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<img src="/logo-lockup.svg" alt="ZeroDayDiary" />
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Briefings</HeaderLink>
			<HeaderLink href="/categories">Categories</HeaderLink>
			<HeaderLink href="/search">Search</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(14px);
		background: rgba(7, 10, 18, 0.92);
		border-bottom: 1px solid rgba(148, 163, 184, 0.14);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		padding: 0.8rem 0;
		min-width: 0;
	}
	.brand img {
		display: block;
		height: 3rem;
		width: auto;
		max-width: min(100%, 24rem);
	}
	nav {
		width: min(1180px, calc(100% - 2rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	:global(.internal-links a) {
		padding: 1rem 0.72rem;
		color: rgba(226, 232, 240, 0.82);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		font-size: 0.88rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	:global(.internal-links a.active) {
		border-bottom-color: #22d3ee;
		color: #fff;
	}
	@media (max-width: 860px) {
		.brand img {
			height: 2.55rem;
			max-width: 20rem;
		}
		nav {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.35rem 0 0.6rem;
		}
		.internal-links {
			flex-wrap: wrap;
		}
		:global(.internal-links a) {
			padding: 0.45rem 0.58rem;
		}
	}
	@media (max-width: 480px) {
		.brand img {
			height: 1.95rem;
			max-width: 14.5rem;
		}
	}
</style>
