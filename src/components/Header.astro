---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav>
		<a class="brand" href="/">
			<span class="brand-mark"><img src="/logo-mark.svg" alt="" aria-hidden="true" /></span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<small>Signal over noise</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Briefings</HeaderLink>
			<HeaderLink href="/categories">Categories</HeaderLink>
			<HeaderLink href="/search">Search</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(14px);
		background: rgba(7, 10, 18, 0.92);
		border-bottom: 1px solid rgba(148, 163, 184, 0.14);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
		padding: 1.2rem 0;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		line-height: 1;
		flex: 0 0 auto;
	}
	.brand-mark img {
		display: block;
		width: 3rem;
		height: 3rem;
	}
	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1.02;
	}
	.brand-copy strong {
		color: #f8fafc;
		font-size: 1.35rem;
		font-family: Arial, sans-serif;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.brand-copy small {
		color: rgba(226, 232, 240, 0.64);
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.24em;
	}
	nav {
		width: min(1600px, calc(100% - 2rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.8rem;
	}
	:global(.internal-links a) {
		padding: 2.1rem 0.15rem 1.75rem;
		color: rgba(226, 232, 240, 0.82);
		text-decoration: none;
		border-bottom: 3px solid transparent;
		font-size: 1.08rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}
	:global(.internal-links a.active) {
		border-bottom-color: #22d3ee;
		color: #fff;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.35rem 0 0.6rem;
		}
		.internal-links {
			flex-wrap: wrap;
		}
		:global(.internal-links a) {
			padding: 0.45rem 0.58rem;
		}
	}
</style>
