---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav>
		<a class="brand" href="/">
			<span class="brand-mark">ZD</span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<small>Signal over noise</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Briefings</HeaderLink>
			<HeaderLink href="/categories">Categories</HeaderLink>
			<HeaderLink href="/search">Search</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(14px);
		background: rgba(7, 10, 18, 0.92);
		border-bottom: 1px solid rgba(148, 163, 184, 0.14);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
		padding: 0.72rem 0;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 0.7rem;
		color: #f8fafc;
		background: linear-gradient(135deg, #0ea5e9, #8b5cf6);
		box-shadow: 0 10px 24px rgba(14, 165, 233, 0.2);
		font-size: 0.84rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		line-height: 1;
	}
	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1.02;
	}
	.brand-copy strong {
		color: #f8fafc;
		font-size: 0.96rem;
		letter-spacing: 0.01em;
	}
	.brand-copy small {
		color: rgba(226, 232, 240, 0.64);
		font-size: 0.67rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
	}
	nav {
		width: min(1180px, calc(100% - 2rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	:global(.internal-links a) {
		padding: 1rem 0.72rem;
		color: rgba(226, 232, 240, 0.82);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		font-size: 0.88rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	:global(.internal-links a.active) {
		border-bottom-color: #22d3ee;
		color: #fff;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.35rem 0 0.6rem;
		}
		.internal-links {
			flex-wrap: wrap;
		}
		:global(.internal-links a) {
			padding: 0.45rem 0.58rem;
		}
	}
</style>
